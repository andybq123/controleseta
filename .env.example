# Client-side (bundled into the browser build — safe to expose).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side only (never bundled into the client).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Service-role key: bypasses RLS. Only set in the real server environment
# (Docker/systemd env, not this file) — never commit the actual value.
SUPABASE_SERVICE_ROLE_KEY=

# Port the Node server listens on (see server/start script).
PORT=3000
