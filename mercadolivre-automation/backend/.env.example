# Porta do backend (o painel web e a API sobem juntos nessa porta)
PORT=4000

# Segredo usado para assinar os tokens JWT do painel. Troque por um valor aleatorio forte.
JWT_SECRET=troque-este-valor-por-uma-string-aleatoria-longa

# Credenciais do administrador criadas automaticamente no primeiro start
# (depois podem ser trocadas dentro do proprio painel, em Configuracoes > Conta)
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Caminho do arquivo do banco SQLite (dados, configuracoes, historico e logs)
DATABASE_PATH=./data/app.db
