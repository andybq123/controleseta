# Porta exposta na VPS para acessar o painel (http://SEU_IP:APP_PORT)
APP_PORT=4000

# Segredo para assinar os tokens de login do painel. Gere um valor aleatorio, por exemplo com:
#   openssl rand -hex 32
JWT_SECRET=troque-este-valor-por-uma-string-aleatoria-longa

# Credenciais do administrador criadas no primeiro start do container.
# Depois do primeiro login, troque a senha em Configuracoes > Conta dentro do painel.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
