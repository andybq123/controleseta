{
  "manifest_version": 3,
  "name": "Coletor de Protocolos 1doc",
  "version": "1.1.0",
  "description": "Coleta protocolos arquivados de Ouvidoria no 1doc e envia ao painel.",
  "permissions": ["activeTab", "storage", "scripting", "tabs"],
  "host_permissions": ["https://*.1doc.com.br/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}